<Window x:Class="ScreenExposure.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenExposure.App"
        Title="Screen Exposure"
        Width="1040"
        Height="680"
        MinWidth="920"
        MinHeight="600"
        Background="#101317"
        Foreground="#F1F5F4">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE4E1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#F8FAF9" />
            <Setter Property="Background" Value="#26313A" />
            <Setter Property="BorderBrush" Value="#3D4A53" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Screen Exposure" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock Text="曲线、通道和曝光调整会实时写入 Windows Gamma Ramp；保存 ICC 会生成带 vcgt 曲线的配置文件。"
                           Margin="0,6,0,0"
                           Foreground="#9EAAA6" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#1A2026" BorderBrush="#2E3942" BorderThickness="1" Padding="12,8">
                <TextBlock x:Name="StatusText" Text="未应用" Foreground="#9EAAA6" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#151A1F" BorderBrush="#2B343C" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="曲线" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton x:Name="MasterChannelButton" Content="RGB" IsChecked="True" Margin="0,0,12,0" Checked="OnChannelChanged" />
                            <RadioButton x:Name="RedChannelButton" Content="R" Margin="0,0,12,0" Checked="OnChannelChanged" />
                            <RadioButton x:Name="GreenChannelButton" Content="G" Margin="0,0,12,0" Checked="OnChannelChanged" />
                            <RadioButton x:Name="BlueChannelButton" Content="B" Checked="OnChannelChanged" />
                        </StackPanel>
                    </DockPanel>

                    <local:CurveEditor x:Name="CurveEditor"
                                       Grid.Row="1"
                                       CurveChanged="OnCurveChanged" />

                    <TextBlock Grid.Row="2"
                               Text="点击添加控制点，拖动调整曲线；选中点后按 Delete 删除。端点只允许上下移动。"
                               Margin="0,12,0,0"
                               Foreground="#8F9A96" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#151A1F" BorderBrush="#2B343C" BorderThickness="1" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="画面调整" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />

                        <TextBlock Text="曝光 Stops" Margin="0,18,0,0" />
                        <DockPanel>
                            <TextBlock x:Name="ExposureValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" Foreground="#FFFFFF" />
                            <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="1" Value="0" TickFrequency="0.1" ValueChanged="OnAdjustmentChanged" />
                        </DockPanel>

                        <TextBlock Text="对比度" />
                        <DockPanel>
                            <TextBlock x:Name="ContrastValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" Foreground="#FFFFFF" />
                            <Slider x:Name="ContrastSlider" Minimum="-0.5" Maximum="0.8" Value="0" TickFrequency="0.05" ValueChanged="OnAdjustmentChanged" />
                        </DockPanel>

                        <TextBlock Text="Gamma" />
                        <DockPanel>
                            <TextBlock x:Name="GammaValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" Foreground="#FFFFFF" />
                            <Slider x:Name="GammaSlider" Minimum="0.35" Maximum="1.8" Value="1" TickFrequency="0.05" ValueChanged="OnAdjustmentChanged" />
                        </DockPanel>

                        <TextBlock Text="显示器" Margin="0,8,0,0" />
                        <ComboBox x:Name="DisplayComboBox" DisplayMemberPath="FriendlyName" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="应用" Click="OnApplyClicked" />
                            <Button Content="恢复" Click="OnRestoreClicked" />
                            <Button Content="重置" Click="OnResetClicked" />
                        </StackPanel>

                        <TextBlock Text="ICC 同步" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,26,0,0" />
                        <TextBlock Text="生成基于系统 sRGB 的 ICC，并写入当前曲线的 vcgt 校准表。某些游戏、HDR 或独占全屏可能不会读取 ICC。"
                                   Margin="0,8,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="#9EAAA6" />
                        <Button Content="保存并设为当前显示器 ICC" Click="OnSaveIccClicked" Margin="0,0,0,0" />

                        <TextBlock Text="预设" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,26,0,8" />
                        <WrapPanel>
                            <Button Content="室外压暗" Click="OnOutdoorPresetClicked" />
                            <Button Content="夜间" Click="OnNightPresetClicked" />
                            <Button Content="默认" Click="OnDefaultPresetClicked" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   Text="建议先关闭 HDR 再测试。应用后如果画面异常，点“恢复”或关闭程序会尝试恢复原始 Gamma Ramp。"
                   Foreground="#8F9A96" />
    </Grid>
</Window>
